{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Hosted Mend execution is disabled. The repository Action loads and enables this JSON from its trusted main checkout; Dependabot owns security PRs.",
  "enabled": false,
  "enabledManagers": ["npm", "github-actions", "dockerfile", "docker-compose"],
  "automerge": false,
  "platformAutomerge": false,
  "osvVulnerabilityAlerts": false,
  "vulnerabilityAlerts": { "enabled": false },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    { "matchPackageNames": ["@tiptap/**"], "groupName": "tiptap" },
    { "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"], "groupName": "react" },
    { "matchPackageNames": ["@typescript-eslint/**", "typescript", "eslint", "@eslint/**"], "groupName": "typescript tooling" },
    { "matchPackageNames": ["github/codeql-action"], "groupName": "codeql" },
    { "description": "Keep the required validation runtime on Node 24 LTS", "matchDatasources": ["node-version"], "matchCurrentValue": "/^24(?:\\.|$)/", "allowedVersions": ">=24 <25" },
    { "matchDatasources": ["docker"], "pinDigests": true },
    {
      "description": "Application image versions belong exclusively to the release pipeline, across every manager",
      "matchPackageNames": ["squadrules/mcp", "docker.io/squadrules/mcp", "quay.io/squadrules/mcp"],
      "enabled": false
    }
  ]
}
