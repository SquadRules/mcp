#!/bin/sh
# Developer guard: version tags are created by Release Please after a protected
# Release PR is merged. Developers must never push v* tags by hand.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if echo "$remote_ref" | grep -q "^refs/tags/v"; then
    echo >&2 ""
    echo >&2 "  ERROR: Do not push release tags manually."
    echo >&2 ""
    echo >&2 "  Merge normal work through PRs. Release Please maintains a separate Release PR"
    echo >&2 "  containing package.json/package-lock/changelog/version-source updates."
    echo >&2 "  After that Release PR passes the normal required checks and is merged,"
    echo >&2 "  Release Please creates the vX.Y.Z tag/GitHub Release and release.yml publishes npm."
    echo >&2 "  Procedure: .agents/skills/squadrules-dev/references/release-semver.md"
    echo >&2 ""
    exit 1
  fi
done
exit 0
