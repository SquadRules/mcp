# Fullstack: infra + app + auth. Used by scripts/deploy-generate-dev-secrets.py to produce .env (same keys as CI integration job).
# Keycloak realms: scripts/keycloak/import/*.json + python3 scripts/deploy-configure-keycloak-realms.py (optional vars in scripts/env/env.rc).
KEYCLOAK_ADMIN_PASSWORD=__KEYCLOAK_ADMIN_PASSWORD__
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_DB_PASSWORD=__KEYCLOAK_DB_PASSWORD__
KEY_VALUE_STORE_PASSWORD=__REDIS_PASSWORD__
# Legacy alias (optional): REDIS_PASSWORD
QDRANT_API_KEY=__QDRANT_API_KEY__
QDRANT_COLLECTION=squadrules_ci
# Vector-store selection is a single switch: a non-empty QDRANT_URL selects the Qdrant
# backend. This template is the full-stack/CI profile, which runs Qdrant, so it stays
# set here. Leave QDRANT_URL empty/unset for the embedded LanceDB default (npx serve
# needs no Qdrant/Redis/Docker). See docs/known-issues-and-limitations.md#vector-store-backends.
QDRANT_URL=http://127.0.0.1:6333
KEY_VALUE_STORE_URL=redis://:__REDIS_PASSWORD__@127.0.0.1:6379
# Legacy alias (optional): REDIS_URL
# Main HTTP listener when TRANSPORT_TYPE=http: UI, REST API, and Streamable HTTP MCP.
SERVER_PORT=3300
METRICS_PORT=9390
# Optional: absolute path (or cwd-relative) to the Vite output directory (dist/ui). Use when the server serves an unexpected UI tree.
# SQUADRULES_UI_DIR=
# Concurrency limit for MCP POST /mcp; 0=auto-detect, -1=disabled. High dev default avoids integration-test stalls; use a low value (e.g. 10) for load/concurrency tests (tests/load, npm run test:load).
MAX_CONCURRENT_MCP_REQUESTS=10000
# When true, MCP App chat widgets skip ui/initialize and ignore tool results (static shell for host debugging).
# SQUADRULES_MCP_WIDGET_PRESENTATION_ONLY=false
NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json
SQUADRULES_KEY_VALUE_PREFIX=squadrules:dev:
# Legacy alias (optional): SQUADRULES_REDIS_PREFIX
# Embedding backend selection (issue #11): with no external provider configured the app uses
# the LOCAL fastembed default (no API key, no inference service) - this is what simple mode and
# `npx @squadrules/mcp serve` run. This template is the full-stack/CI profile, which opts into
# OpenAI, so EMBEDDING_PROVIDER=openai stays set here. FASTEMBED_MODEL/FASTEMBED_CACHE_DIR have
# app defaults (fast-bge-small-en-v1.5 @ 384 dims; cache under the shared per-user models dir).
# TEI is DEPRECATED (issue #11) - kept working as an opt-in alternative.
# See docs/install/prerequisites.md#embedding-backend.
OPENAI_API_KEY=__OPENAI_API_KEY__
# OPENAI_EMBEDDING_MODEL and OPENAI_API_URL have app defaults; set to override.
EMBEDDING_PROVIDER=openai
# FASTEMBED_MODEL=fast-bge-small-en-v1.5
# FASTEMBED_CACHE_DIR=
QDRANT_RESCORE=true
QDRANT_SNAPSHOT_DIR=.local/var/snapshots
AUTH_ENABLED=true
SESSION_SECRET=__SESSION_SECRET__
SESSION_MAX_AGE_SEC=25200
AUTH_CALLBACK_BASE_URL=http://localhost:3300
# Optional: expand squadrules-mcp redirect URIs for every port from MIN through MAX (localhost + 127.0.0.1). Defaults match 3300–3301. Run: python3 scripts/deploy-configure-keycloak-realms.py
# SQUADRULES_DEV_APP_PORT_MIN=3300
# SQUADRULES_DEV_APP_PORT_MAX=3301
# For E2E and CLI browser login, KEYCLOAK_URL must be a URL the browser can open (e.g. http://localhost:8080). deploy-run-env.sh overrides keycloak:8080 to localhost:8080 when starting the dev server.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=squadrules-dev
KEYCLOAK_CLIENT_ID=squadrules-mcp
KEYCLOAK_CLI_CLIENT_ID=squadrules-cli
# Only set when the app runs inside Docker (so it can reach Keycloak by hostname). Leave unset when app runs on host (e.g. npm run dev:start).
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080
AUTH_MODE=oidc_bearer
AUTH_TRUSTED_ISSUERS=http://localhost:8080/realms/squadrules-dev
# Include both so server (squadrules-mcp) and CLI (squadrules-cli) tokens are accepted
AUTH_ALLOWED_AUDIENCES=squadrules-mcp,squadrules-cli
# Optional: scopes advertised from /.well-known/oauth-protected-resource.
# Default: openid,profile,email,squadrules-groups
# Add offline_access only if your IdP policy permits refresh-token scope for clients.
# SQUADRULES_OIDC_SCOPES_SUPPORTED=openid,profile,email,squadrules-groups,offline_access
# Optional: intersect JWT `groups` with this list (comma-separated full paths).
# Use trailing `/` for path-prefix matching (for example, /shared/).
# Empty or unset = all JWT group paths are accepted as spaces (no filtering). Set entries to restrict.
# OIDC_GROUPS_ALLOWLIST=/squadrules-auditor,/shared/
# Optional: example group path in MCP tool descriptions (activate, spaces, train, tune).
# Default: derived from the first path-prefix entry in OIDC_GROUPS_ALLOWLIST plus
# SQUADRULES_GROUP_SPACE_EXAMPLE_SUFFIX (default pe-team), e.g. /shared/ → /shared/pe-team.
# SQUADRULES_GROUP_SPACE_PATH_EXAMPLE=/shared/pe-team
# SQUADRULES_GROUP_SPACE_EXAMPLE_SUFFIX=pe-team
# Optional: second Keycloak user (dev) used only for /shared/ci-test — provisioned by scripts/deploy-configure-keycloak-realms.py
# SQUADRULES_CI_TEST_USERNAME=squadrules-ci-tester
# SQUADRULES_CI_TEST_PASSWORD=squadrules-ci-tester-secret
# Optional: for scripts/deploy-configure-keycloak-google-idp.py (Google IdP in squadrules-dev)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
