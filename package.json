{
  "name": "@squadrules/mcp",
  "version": "5.2.0",
  "description": "SquadRules MCP server for agent automation: persistent memory and deterministic workflow execution for AI agents and chats",
  "type": "module",
  "main": "dist/index.js",
  "author": "Jakub Plichcinski <kuba@xpl.pl>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SquadRules/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SquadRules/mcp/issues"
  },
  "homepage": "https://github.com/SquadRules/mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-automation",
    "workflow-orchestration",
    "ai-agents",
    "ai-memory",
    "knowledge-management",
    "vector-database",
    "qdrant",
    "semantic-search",
    "ai-infrastructure"
  ],
  "bin": {
    "squadrules": "dist/cli/index.js",
    "squadrules-mcp": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "cli": "node dist/cli/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit --testTimeout=30000",
    "start": "node dist/cli/index.js serve",
    "dev:node": "./scripts/dev-node-use.sh",
    "dev:test-embedding-key": "node scripts/test-embedding-key.mjs",
    "build": "npm run ui:build && tsc && chmod +x dist/cli/index.js",
    "ui:build": "vite build",
    "design:viewports": "node scripts/test-capture-viewports.mjs",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:audit-fix-workflow": "bash tests/scripts/npm-audit-fix.test.sh",
    "test:automation": "node --test tests/scripts/*.test.mjs",
    "lint:workflows": "node scripts/ci-validate-workflows.mjs",
    "lint:renovate": "node scripts/ci-renovate.mjs validate",
    "ci:controller": "node scripts/ci-automation.mjs",
    "ci:renovate": "node scripts/ci-renovate.mjs",
    "ci:audit": "node scripts/ci-audit.mjs",
    "ci:health": "node scripts/ci-health.mjs",
    "test:spec-parity": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPatterns tests/unit/spec-parity.test.ts",
    "test:ui:watch": "vitest --config vitest.config.ts",
    "pack": "npm run build:tgz",
    "knip": "node -e \"if(process.env.DOCKER_BUILD)process.exit(0); const r=require('child_process').spawnSync('npx',['knip','--no-config-hints'],{stdio:'inherit'});process.exit(r.status!=null?r.status:1)\"",
    "lint": "eslint . && npm run lint:skills && npm run lint:markdown && npm run lint:docs",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs --fix && npm run lint:markdown:fix",
    "lint:skills": "python3 scripts/lint-agent-skills.py",
    "lint:docs": "node scripts/lint-docs-links.mjs",
    "lint:markdown": "markdownlint-cli2 'docs/**/*.md' 'README.md' 'CONTRIBUTING.md' 'SECURITY.md' --config .markdownlint.jsonc --no-progress",
    "lint:markdown:fix": "markdownlint-cli2 'docs/**/*.md' 'README.md' 'CONTRIBUTING.md' 'SECURITY.md' --config .markdownlint.jsonc --no-progress --fix",
    "lint:mermaid": "./scripts/validate-mermaid.sh docs/**/*.md",
    "version:sync": "npm run version:sync-skills",
    "version:sync-skills": "node scripts/build-sync-skill-versions.mjs",
    "version:check-skills": "node scripts/build-sync-skill-versions.mjs --check",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && npm run verify:clean && npm run version:sync-skills && ts-node scripts/build-embed-docs.ts",
    "verify:clean": "node scripts/lint-verify-clean-source.mjs",
    "prepare": "husky",
    "build:tgz": "mkdir -p artifacts && npm pack --pack-destination artifacts",
    "test:tgz": "node scripts/ci-test-tgz-install.mjs",
    "test:package-local": "npm run build:tgz && npm run test:tgz",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.ui.json",
    "release:verify-version": "node scripts/ci-verify-release-version.mjs"
  },
  "dependencies": {
    "@exodus/bytes": "^1.15.0",
    "@lancedb/lancedb": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@napi-rs/keyring": "^2.0.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "@tanstack/react-query": "5.103.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "archiver": "^8.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.0",
    "fastembed": "^3.0.0",
    "helmet": "^8.1.0",
    "i18next": "^26.0.2",
    "jose": "6.2.12",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "raw-body": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "redis": "^6.2.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@jest/globals": "^30.2.0",
    "@jest/test-sequencer": "^30.2.0",
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "26.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "10.0.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "10.11.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "js-yaml": "^4.2.0",
    "jsdom": "30.0.1",
    "knip": "6.35.1",
    "markdownlint-cli2": "0.23.3",
    "pino-pretty": "^13.1.3",
    "playwright": "1.63.0",
    "tailwindcss": "^4.0.0",
    "testcontainers": "^12.0.0",
    "ts-jest": "29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "undici": "8.10.2",
    "vite": "^8.0.14",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "path-to-regexp": "^8.4.0",
    "glob": "^13.0.0",
    "minimatch": "^10.2.3",
    "tar": "^7.5.19",
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0",
    "js-yaml": "^4.2.0",
    "markdown-it": "^14.2.0",
    "shell-quote": "^1.12.0",
    "react-router": "^8.3.0",
    "typescript": "^5.9.3",
    "brace-expansion": "^5.0.12",
    "undici": "8.10.2",
    "katex": "^0.18.2",
    "source-map-js": "^1.2.2",
    "fast-copy": "^4.1.2",
    "global-agent": "^4.1.3",
    "markdownlint-cli2": {
      "smol-toml": "^1.9.0"
    }
  },
  "allowScripts": {
    "puppeteer@25.4.0": true
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
