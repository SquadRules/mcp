AUTH_ENABLED=false

METRICS_PORT=9490

# stdio is local simple mode: embedded LanceDB, no shared Qdrant, no auth. src/config.ts
# refuses to boot a stdio process that sets QDRANT_URL (per-process in-memory KV/cache
# state cannot share a remote collection), so the store vars stay empty on this profile.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=squadrules_simple_ci

# Disable auth dependency wiring in stdio local mode.
KEYCLOAK_URL=
KEYCLOAK_INTERNAL_URL=
KEY_VALUE_STORE_URL=
KEY_VALUE_STORE_PASSWORD=
REDIS_URL=
REDIS_PASSWORD=

# Local stdio transport: MCP only on stdin/stdout (no HTTP app; SERVER_PORT not used).
TRANSPORT_TYPE=stdio
