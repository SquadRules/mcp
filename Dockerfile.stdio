# DEPRECATED: @squadrules/mcp is an npm-only package. Container images are built in
# SquadRules/containers from the published npm package. Retained for reference pending
# Docker cleanup; do not extend.
FROM qdrant/qdrant:v1.19.1@sha256:12364fe851b9f17356fc88189fc06d1b521262e04659ec7345975b00c9246a10 AS qdrant

FROM node:26-bookworm-slim@sha256:662933cf47f013bc8e4beb31a6116448427a82057ba7c42c97e4c5ba766504c2

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    tini \
    libunwind8 \
    libssl3 \
    libstdc++6 \
    libgcc-s1 \
    zlib1g \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1001 nodejs && useradd -u 1001 -g nodejs -m -s /usr/sbin/nologin squadrules

WORKDIR /app

ARG PACKAGE_VERSION=4.4.0
RUN test -n "$PACKAGE_VERSION"

RUN printf '%s\n' "{\"private\":true,\"dependencies\":{\"@squadrules/mcp\":\"${PACKAGE_VERSION}\"},\"overrides\":{\"minimatch\":\"^10.2.3\",\"tar\":\"^7.5.19\"}}" > package.json && \
    npm install --omit=dev && \
    npm cache clean --force

COPY --from=qdrant /qdrant/qdrant /usr/local/bin/qdrant
COPY scripts/stdio/entrypoint.sh /usr/local/bin/squadrules-stdio-entrypoint

RUN chmod +x /usr/local/bin/qdrant /usr/local/bin/squadrules-stdio-entrypoint && \
    mkdir -p /var/lib/qdrant/storage && \
    chown -R squadrules:nodejs /var/lib/qdrant /app

USER squadrules

ENV NODE_ENV=production
ENV TRANSPORT_TYPE=stdio
ENV AUTH_ENABLED=false
ENV QDRANT_URL=http://127.0.0.1:6333
ENV QDRANT_COLLECTION=squadrules
ENV EMBEDDING_PROVIDER=openai
ENV QDRANT__SERVICE__HOST=127.0.0.1
ENV QDRANT__SERVICE__HTTP_PORT=6333
ENV QDRANT__SERVICE__GRPC_PORT=6334
ENV QDRANT__STORAGE__STORAGE_PATH=/var/lib/qdrant/storage

ENTRYPOINT ["tini","--","/usr/local/bin/squadrules-stdio-entrypoint"]
